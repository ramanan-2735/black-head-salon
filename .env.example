# Site tier: "premium" (full build) or "professional" (static site, no booking/admin).
NEXT_PUBLIC_SITE_TIER=premium

# "true" shows sample content and never sends messages or creates bookings.
NEXT_PUBLIC_DEMO_MODE=true

# "instant" confirms bookings straight away. "approval" leaves them pending for the owner.
NEXT_PUBLIC_BOOKING_MODE=instant

# Public site URL for the sitemap. Set once the domain is known, e.g. https://example.com
NEXT_PUBLIC_SITE_URL=
